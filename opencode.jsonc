{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": { "Authorization": "Bearer {env:CONTEXT7_API_KEY}" }
    },
    "grep-mcp": {
      "type": "local",
      "command": ["~/.local/bin/grep-mcp"],
      "enabled": true
    }
  },
  "skills": {
    "delegated-development": true
  }
}
